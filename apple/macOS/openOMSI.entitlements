<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- signed for distribution outside the App Store (Developer ID, notarised): the hardened
	     runtime, and the Steam library beside the game, which Valve signs -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
