    "Only the ticket asked for": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Толькі запытаны білет"}},"ca":{"stringUnit":{"state":"translated","value":"Només la petició del bitllet"}},"cs":{"stringUnit":{"state":"translated","value":"Jen požadovaná jízdenka"}},"de":{"stringUnit":{"state":"translated","value":"Nur der gewünschte Fahrschein"}},"es":{"stringUnit":{"state":"translated","value":"Solo el billete pedido"}},"fr":{"stringUnit":{"state":"translated","value":"Uniquement le billet demandé"}},"hi":{"stringUnit":{"state":"translated","value":"सिर्फ़ माँगा गया टिकट"}},"hu":{"stringUnit":{"state":"translated","value":"Csak jegyeladáskor"}},"id":{"stringUnit":{"state":"translated","value":"Hanya permintaan tiket"}},"it":{"stringUnit":{"state":"translated","value":"Solo il biglietto richiesto"}},"ja":{"stringUnit":{"state":"translated","value":"求められた乗車券のみ"}},"kk":{"stringUnit":{"state":"translated","value":"Тек сұралған билет"}},"ko":{"stringUnit":{"state":"translated","value":"승차권 요청만"}},"ms":{"stringUnit":{"state":"translated","value":"Permintaan tiket sahaja"}},"nl":{"stringUnit":{"state":"translated","value":"Alleen het gevraagde kaartje"}},"pl":{"stringUnit":{"state":"translated","value":"Tylko prośba o bilet"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Só a passagem pedida"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Só a bilhete pedida"}},"ru":{"stringUnit":{"state":"translated","value":"Только просьба о билете"}},"sv":{"stringUnit":{"state":"translated","value":"Endast biljettbeställningen"}},"th":{"stringUnit":{"state":"translated","value":"เฉพาะคำขอซื้อตั๋ว"}},"fil":{"stringUnit":{"state":"translated","value":"Ticket request lang"}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca istenen bilet"}},"uk":{"stringUnit":{"state":"translated","value":"Лише запитаний квиток"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ yêu cầu mua vé"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅所需车票"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只讀出購票要求"}}}},
    "Open": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Obre"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir"}},"nl":{"stringUnit":{"state":"translated","value":"Openen"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Abrir"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"打開"}}}},
    "Open openOMSI in Files": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Адкрыць openOMSI у «Файлах»"}},"ca":{"stringUnit":{"state":"translated","value":"Obre openOMSI a Fitxers"}},"cs":{"stringUnit":{"state":"translated","value":"Otevřít openOMSI v Souborech"}},"de":{"stringUnit":{"state":"translated","value":"openOMSI in Dateien öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir openOMSI en Archivos"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir openOMSI dans Fichiers"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ाइलें ऐप में openOMSI खोलें"}},"hu":{"stringUnit":{"state":"translated","value":"openOMSI megnyitása a Fájlokban"}},"id":{"stringUnit":{"state":"translated","value":"Buka openOMSI di File"}},"it":{"stringUnit":{"state":"translated","value":"Apri openOMSI in File"}},"ja":{"stringUnit":{"state":"translated","value":"「ファイル」でopenOMSIを開く"}},"kk":{"stringUnit":{"state":"translated","value":"openOMSI-ді «Файлдар» қолданбасында ашу"}},"ko":{"stringUnit":{"state":"translated","value":"파일에서 openOMSI 열기"}},"ms":{"stringUnit":{"state":"translated","value":"Buka openOMSI dalam Fail"}},"nl":{"stringUnit":{"state":"translated","value":"openOMSI openen in Bestanden"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz openOMSI w Plikach"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir o openOMSI no app Arquivos"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Abrir o openOMSI na app Ficheiros"}},"ru":{"stringUnit":{"state":"translated","value":"Открыть openOMSI в «Файлах»"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna openOMSI i Filer"}},"th":{"stringUnit":{"state":"translated","value":"เปิด openOMSI ใน “ไฟล์”"}},"fil":{"stringUnit":{"state":"translated","value":"Buksan ang openOMSI sa Files"}},"tr":{"stringUnit":{"state":"translated","value":"openOMSI'yi Dosyalar'da açın"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити openOMSI у «Файлах»"}},"vi":{"stringUnit":{"state":"translated","value":"Mở openOMSI trong Tệp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“文件”中打开openOMSI"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在「檔案」中開啟 openOMSI"}}}},
    "Or copy it into openOMSI in the Files app: the drive is then no longer needed.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Або скапіруйце яе ў openOMSI у праграме «Файлы»: тады назапашвальнік больш не спатрэбіцца."}},"ca":{"stringUnit":{"state":"translated","value":"O copia-la a openOMSI amb l'app Fitxers: així ja no caldrà la memòria."}},"cs":{"stringUnit":{"state":"translated","value":"Nebo ji zkopírujte do openOMSI v aplikaci Soubory: disk pak už nebude potřeba."}},"de":{"stringUnit":{"state":"translated","value":"Oder kopiere ihn in der Dateien-App in openOMSI: Dann wird der Stick nicht mehr gebraucht."}},"es":{"stringUnit":{"state":"translated","value":"O cópiala en openOMSI con la app Archivos: así ya no necesitarás la memoria."}},"fr":{"stringUnit":{"state":"translated","value":"Ou copiez-le dans openOMSI avec l'app Fichiers : la clé n'est alors plus nécessaire."}},"hi":{"stringUnit":{"state":"translated","value":"या फ़ाइलें ऐप में इसे openOMSI में कॉपी करें: फिर ड्राइव की ज़रूरत नहीं रहेगी।"}},"hu":{"stringUnit":{"state":"translated","value":"Vagy másold át az openOMSI-ba a Fájlok appban: így már nem lesz szükség a meghajtóra."}},"id":{"stringUnit":{"state":"translated","value":"Atau salin ke openOMSI di app File: drive tidak diperlukan lagi."}},"it":{"stringUnit":{"state":"translated","value":"Oppure copiala in openOMSI con l'app File: così la chiavetta non serve più."}},"ja":{"stringUnit":{"state":"translated","value":"または「ファイル」アプリでopenOMSIにコピーすれば、ドライブは不要になります。"}},"kk":{"stringUnit":{"state":"translated","value":"Немесе оны «Файлдар» қолданбасында openOMSI ішіне көшіріңіз: сонда жинақтағыш енді керек болмайды."}},"ko":{"stringUnit":{"state":"translated","value":"또는 파일 앱에서 openOMSI로 복사하세요. 그러면 드라이브가 더 이상 필요 없습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Atau salin ke openOMSI dalam app Fail: pemacu tidak diperlukan lagi."}},"nl":{"stringUnit":{"state":"translated","value":"Of kopieer hem in de Bestanden-app naar openOMSI: dan is de stick niet meer nodig."}},"pl":{"stringUnit":{"state":"translated","value":"Albo skopiuj go do openOMSI w aplikacji Pliki: wtedy dysk nie będzie już potrzebny."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ou copie-a para o openOMSI no app Arquivos: assim o pendrive não é mais necessário."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ou copie-a para o openOMSI na app Ficheiros: assim a pen deixa de ser necessária."}},"ru":{"stringUnit":{"state":"translated","value":"Или скопируйте её в openOMSI в приложении «Файлы»: тогда накопитель больше не понадобится."}},"sv":{"stringUnit":{"state":"translated","value":"Eller kopiera den till openOMSI i appen Filer: då behövs inte USB-minnet längre."}},"th":{"stringUnit":{"state":"translated","value":"หรือคัดลอกลงใน openOMSI ในแอป “ไฟล์” แล้วก็ไม่ต้องใช้ไดรฟ์อีก"}},"fil":{"stringUnit":{"state":"translated","value":"O kopyahin ito sa openOMSI sa Files app: hindi na kailangan ang drive pagkatapos."}},"tr":{"stringUnit":{"state":"translated","value":"Ya da Dosyalar uygulamasında openOMSI'ye kopyalayın: o zaman belleğe artık gerek kalmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Або скопіюйте її в openOMSI у застосунку «Файли»: тоді накопичувач більше не знадобиться."}},"vi":{"stringUnit":{"state":"translated","value":"Hoặc sao chép vào openOMSI trong ứng dụng Tệp: khi đó không cần ổ nữa."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"也可以在“文件”App中将它复制到openOMSI：之后就不再需要U盘了。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"也可以在「檔案」App 中將它複製到 openOMSI：之後就不再需要隨身碟。"}}}},
