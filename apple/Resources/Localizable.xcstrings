    "The driver sells the ticket": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіцель прадае білет"}},"ca":{"stringUnit":{"state":"translated","value":"El conductor ven el bitllet"}},"cs":{"stringUnit":{"state":"translated","value":"Řidič prodává jízdenku"}},"de":{"stringUnit":{"state":"translated","value":"Der Fahrer verkauft den Fahrschein"}},"es":{"stringUnit":{"state":"translated","value":"El conductor vende el billete"}},"fr":{"stringUnit":{"state":"translated","value":"Le conducteur vend le ticket"}},"hi":{"stringUnit":{"state":"translated","value":"टिकट ड्राइवर बेचता है"}},"hu":{"stringUnit":{"state":"translated","value":"Realisztikus/Valós"}},"id":{"stringUnit":{"state":"translated","value":"Sopir menjual tiket"}},"it":{"stringUnit":{"state":"translated","value":"Il conducente vende il biglietto"}},"ja":{"stringUnit":{"state":"translated","value":"運転手が乗車券を販売"}},"kk":{"stringUnit":{"state":"translated","value":"Билетті жүргізуші сатады"}},"ko":{"stringUnit":{"state":"translated","value":"운전자가 승차권 판매"}},"ms":{"stringUnit":{"state":"translated","value":"Pemandu menjual tiket"}},"nl":{"stringUnit":{"state":"translated","value":"De bestuurder verkoopt het kaartje"}},"pl":{"stringUnit":{"state":"translated","value":"Kierowca sprzedaje bilet"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O motorista vende a passagem"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O condutor vende a bilhete"}},"ru":{"stringUnit":{"state":"translated","value":"Билет продаёт водитель"}},"sv":{"stringUnit":{"state":"translated","value":"Föraren säljer biljetten"}},"th":{"stringUnit":{"state":"translated","value":"คนขับขายตั๋ว"}},"fil":{"stringUnit":{"state":"translated","value":"Driver ang nagbebenta ng tiket"}},"tr":{"stringUnit":{"state":"translated","value":"Bileti sürücü satar"}},"uk":{"stringUnit":{"state":"translated","value":"Водій продає квиток"}},"vi":{"stringUnit":{"state":"translated","value":"Tài xế bán vé"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"司机售票"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"由司機售票"}}}},
    "The driver whose personnel file the game writes: hours, kilometres, punctuality, tickets.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіцель, чыю асабістую справу вядзе гульня: гадзіны, кіламетры, пунктуальнасць, білеты."}},"ca":{"stringUnit":{"state":"translated","value":"El conductor del qual el joc desa l'expedient: hores, quilòmetres, puntualitat i bitllets."}},"cs":{"stringUnit":{"state":"translated","value":"Řidič, jehož osobní spis hra vede: hodiny, kilometry, dochvilnost, jízdenky."}},"de":{"stringUnit":{"state":"translated","value":"Der Fahrer, dessen Personalakte das Spiel führt: Stunden, Kilometer, Pünktlichkeit, Fahrscheine."}},"es":{"stringUnit":{"state":"translated","value":"El conductor cuyo expediente escribe el juego: horas, kilómetros, puntualidad, billetes."}},"fr":{"stringUnit":{"state":"translated","value":"Le conducteur dont le jeu maintient le dossier : heures, kilomètres, ponctualité, billets."}},"hi":{"stringUnit":{"state":"translated","value":"वह ड्राइवर जिसकी पर्सनल फ़ाइल गेम लिखता है: घंटे, किलोमीटर, समय-पालन, टिकट।"}},"hu":{"stringUnit":{"state":"translated","value":"A sofőr, akinek a személyi lapját a játék vezeti: Órák, kilométerek, pontosság, jegyeladások és sok más."}},"id":{"stringUnit":{"state":"translated","value":"Game mencatat jam, kilometer, ketepatan waktu, dan tiket pengemudi ini."}},"it":{"stringUnit":{"state":"translated","value":"Il conducente del cui fascicolo personale il gioco tiene traccia: ore, chilometri, puntualità, biglietti."}},"ja":{"stringUnit":{"state":"translated","value":"ゲームが人事ファイルに記録する運転手:時間、キロ数、定時性、乗車券。"}},"kk":{"stringUnit":{"state":"translated","value":"Ойын жеке іс парағын жазатын жүргізуші: сағаттар, километрлер, тұрақтылық, билеттер."}},"ko":{"stringUnit":{"state":"translated","value":"게임이 이 운전자의 운전 시간, 거리, 정시성, 승차권 판매를 기록합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Permainan merekod jam, kilometer, ketepatan masa dan tiket pemandu ini."}},"nl":{"stringUnit":{"state":"translated","value":"De bestuurder van wie het spel het personeelsdossier bijhoudt: uren, kilometers, punctualiteit, kaartjes."}},"pl":{"stringUnit":{"state":"translated","value":"Kierowca, dla którego gra prowadzi akta osobowe: godziny, kilometry, punktualność, bilety."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O motorista cujo registro o jogo mantém: horas, quilômetros, pontualidade e passagens."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O condutor cujo registro o jogo mantém: horas, quilómetros, pontualidade e bilhetes."}},"ru":{"stringUnit":{"state":"translated","value":"Водитель, в личное дело которого игра пишет: часы, километры, пунктуальность, билеты."}},"sv":{"stringUnit":{"state":"translated","value":"Föraren vars personalakt spelet skriver: timmar, kilometer, punktlighet och biljetter."}},"th":{"stringUnit":{"state":"translated","value":"เกมจะบันทึกชั่วโมงขับรถ ระยะทาง ความตรงเวลา และการขายตั๋วของคนขับนี้"}},"fil":{"stringUnit":{"state":"translated","value":"Itinatala ng laro ang oras, kilometro, pagiging nasa oras at tickets ng driver na ito."}},"tr":{"stringUnit":{"state":"translated","value":"Oyunun özlük dosyasını yazdığı sürücü: saat, kilometre, dakiklik, biletler."}},"uk":{"stringUnit":{"state":"translated","value":"Водій, чиє особове діло веде гра: години, кілометри, пунктуальність, квитки."}},"vi":{"stringUnit":{"state":"translated","value":"Trò chơi ghi lại số giờ lái, quãng đường, độ đúng giờ và vé đã bán của tài xế này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游戏为其写入人事档案的司机:工时、公里数、准点率、车票。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲會為這名司機記錄駕駛時數、里程、準時率及售票數據。"}}}},
    "The keyboard brake stays on until the throttle (as in OMSI)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Тормаз з клавіятуры трымаецца да націску газу (як у OMSI)"}},"ca":{"stringUnit":{"state":"translated","value":"El fre del teclat es manté fins que acceleres (com a OMSI)"}},"cs":{"stringUnit":{"state":"translated","value":"Brzda z klávesnice drží až do plynu (jako v OMSI)"}},"de":{"stringUnit":{"state":"translated","value":"Die Tastaturbremse bleibt bis zum Gasgeben (wie in OMSI)"}},"es":{"stringUnit":{"state":"translated","value":"El freno del teclado se mantiene hasta acelerar (como en OMSI)"}},"fr":{"stringUnit":{"state":"translated","value":"Le frein au clavier reste serré jusqu'à l'accélérateur (comme sur OMSI)"}},"hi":{"stringUnit":{"state":"translated","value":"कीबोर्ड ब्रेक थ्रॉटल दबाने तक लगा रहता है (OMSI की तरह)"}},"hu":{"stringUnit":{"state":"translated","value":"A billentyűzetes fék a gázadásig behúzva marad (mint az OMSI-ban)"}},"id":{"stringUnit":{"state":"translated","value":"Rem keyboard tetap tertahan sampai gas ditekan (seperti di OMSI)"}},"it":{"stringUnit":{"state":"translated","value":"Il freno da tastiera resta tirato fino all'acceleratore (come in OMSI)"}},"ja":{"stringUnit":{"state":"translated","value":"キーボードのブレーキはアクセルを踏むまで保持(OMSIと同じ)"}},"kk":{"stringUnit":{"state":"translated","value":"Пернетақта тежегіші газ басылғанша ұсталады (OMSI-дегідей)"}},"ko":{"stringUnit":{"state":"translated","value":"키보드 브레이크는 가속할 때까지 유지(OMSI와 같음)"}},"ms":{"stringUnit":{"state":"translated","value":"Brek papan kekunci kekal sehingga pendikit ditekan (seperti dalam OMSI)"}},"nl":{"stringUnit":{"state":"translated","value":"De toetsenbordrem blijft aan tot je gas geeft (zoals in OMSI)"}},"pl":{"stringUnit":{"state":"translated","value":"Hamulec z klawiatury trzyma do wciśnięcia gazu (jak w OMSI)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O freio do teclado fica acionado até acelerar (como no OMSI)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O freio do teclado fica acionado até acelerar (como no OMSI)"}},"ru":{"stringUnit":{"state":"translated","value":"Тормоз с клавиатуры держится до нажатия газа (как в OMSI)"}},"sv":{"stringUnit":{"state":"translated","value":"Tangentbordsbromsen förblir på tills du gasar (som i OMSI)"}},"th":{"stringUnit":{"state":"translated","value":"เบรกจากคีย์บอร์ดค้างไว้จนกว่าจะเหยียบคันเร่ง (เหมือนใน OMSI)"}},"fil":{"stringUnit":{"state":"translated","value":"Nananatili ang preno ng keyboard hanggang sa gas (tulad sa OMSI)"}},"tr":{"stringUnit":{"state":"translated","value":"Klavye freni gaza basılana kadar basılı kalır (OMSI'deki gibi)"}},"uk":{"stringUnit":{"state":"translated","value":"Гальмо з клавіатури тримається до натискання газу (як в OMSI)"}},"vi":{"stringUnit":{"state":"translated","value":"Phanh bàn phím giữ nguyên cho đến khi nhấn ga (như trong OMSI)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"键盘刹车保持到踩油门为止(与OMSI相同)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"鍵盤煞車保持到踩油門為止(與OMSI相同)"}}}},
