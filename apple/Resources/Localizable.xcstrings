    "OMSI 2 is there but not complete yet: is the copy still running?": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"OMSI 2 ужо тут, але скапіравана яшчэ не цалкам: капіраванне яшчэ ідзе?"}},"ca":{"stringUnit":{"state":"translated","value":"OMSI 2 hi és, però encara no és complet: la còpia encara està en curs?"}},"cs":{"stringUnit":{"state":"translated","value":"OMSI 2 tu je, ale ještě není kompletní: probíhá ještě kopírování?"}},"de":{"stringUnit":{"state":"translated","value":"OMSI 2 ist da, aber noch nicht vollständig: Läuft das Kopieren noch?"}},"es":{"stringUnit":{"state":"translated","value":"OMSI 2 está ahí, pero aún no está completo: ¿la copia sigue en curso?"}},"fr":{"stringUnit":{"state":"translated","value":"OMSI 2 est là, mais pas encore complet : la copie est-elle encore en cours ?"}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 मौजूद है पर अभी पूरा नहीं: क्या कॉपी अभी चल रही है?"}},"hu":{"stringUnit":{"state":"translated","value":"Az OMSI 2 már itt van, de még nem teljes: még tart a másolás?"}},"id":{"stringUnit":{"state":"translated","value":"OMSI 2 sudah ada tetapi belum lengkap: apakah penyalinan masih berjalan?"}},"it":{"stringUnit":{"state":"translated","value":"OMSI 2 c'è, ma non è ancora completo: la copia è ancora in corso?"}},"ja":{"stringUnit":{"state":"translated","value":"OMSI 2は見つかりましたが、まだ揃っていません。コピーはまだ続いていますか？"}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2 осында, бірақ әлі толық емес: көшіру әлі жүріп жатыр ма?"}},"ko":{"stringUnit":{"state":"translated","value":"OMSI 2가 있지만 아직 완전하지 않습니다. 복사가 아직 진행 중인가요?"}},"ms":{"stringUnit":{"state":"translated","value":"OMSI 2 ada di sini tetapi belum lengkap: adakah penyalinan masih berjalan?"}},"nl":{"stringUnit":{"state":"translated","value":"OMSI 2 staat er, maar is nog niet compleet: loopt het kopiëren nog?"}},"pl":{"stringUnit":{"state":"translated","value":"OMSI 2 już tu jest, ale jeszcze niekompletne: czy kopiowanie wciąż trwa?"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OMSI 2 está lá, mas ainda não está completo: a cópia ainda está em andamento?"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O OMSI 2 está lá, mas ainda não está completo: a cópia ainda está a decorrer?"}},"ru":{"stringUnit":{"state":"translated","value":"OMSI 2 уже здесь, но скопирована ещё не полностью: копирование ещё идёт?"}},"sv":{"stringUnit":{"state":"translated","value":"OMSI 2 finns där men är inte komplett än: pågår kopieringen fortfarande?"}},"th":{"stringUnit":{"state":"translated","value":"พบ OMSI 2 แล้วแต่ยังไม่ครบ กำลังคัดลอกอยู่หรือเปล่า?"}},"fil":{"stringUnit":{"state":"translated","value":"Nandito na ang OMSI 2 pero hindi pa kumpleto: tumatakbo pa ba ang pagkopya?"}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2 burada ama henüz tamamlanmadı: kopyalama hâlâ sürüyor mu?"}},"uk":{"stringUnit":{"state":"translated","value":"OMSI 2 вже тут, але скопійована ще не повністю: копіювання ще триває?"}},"vi":{"stringUnit":{"state":"translated","value":"Đã tìm thấy OMSI 2 nhưng chưa đầy đủ: có phải vẫn đang sao chép không?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已找到OMSI 2，但还不完整：复制是否仍在进行？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已找到 OMSI 2，但尚未完整：複製是否仍在進行中？"}}}},
