    "Looking for OMSI 2: it is found by itself once the copy is done.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Шукаем OMSI 2: гульня знойдзецца сама, як толькі капіраванне скончыцца."}},"ca":{"stringUnit":{"state":"translated","value":"Cercant OMSI 2: es trobarà sol quan acabi la còpia."}},"cs":{"stringUnit":{"state":"translated","value":"Hledáme OMSI 2: hra se najde sama, jakmile kopírování skončí."}},"de":{"stringUnit":{"state":"translated","value":"Suche nach OMSI 2: Es wird von selbst gefunden, sobald die Kopie fertig ist."}},"es":{"stringUnit":{"state":"translated","value":"Buscando OMSI 2: se encontrará solo cuando termine la copia."}},"fr":{"stringUnit":{"state":"translated","value":"Recherche d'OMSI 2 : il sera trouvé tout seul une fois la copie terminée."}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 खोजा जा रहा है: कॉपी पूरी होते ही यह अपने आप मिल जाएगा।"}},"hu":{"stringUnit":{"state":"translated","value":"Az OMSI 2 keresése: amint kész a másolás, magától előkerül."}},"id":{"stringUnit":{"state":"translated","value":"Mencari OMSI 2: akan ditemukan otomatis setelah penyalinan selesai."}},"it":{"stringUnit":{"state":"translated","value":"Ricerca di OMSI 2: verrà trovato da solo a copia terminata."}},"ja":{"stringUnit":{"state":"translated","value":"OMSI 2を探しています。コピーが終わると自動で見つかります。"}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2 ізделуде: көшіру аяқталған соң ол өзі табылады."}},"ko":{"stringUnit":{"state":"translated","value":"OMSI 2를 찾는 중입니다. 복사가 끝나면 자동으로 찾습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Mencari OMSI 2: ia akan ditemui secara automatik sebaik sahaja penyalinan selesai."}},"nl":{"stringUnit":{"state":"translated","value":"Zoeken naar OMSI 2: het wordt vanzelf gevonden zodra het kopiëren klaar is."}},"pl":{"stringUnit":{"state":"translated","value":"Szukamy OMSI 2: gra znajdzie się sama, gdy kopiowanie się zakończy."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Procurando o OMSI 2: ele será encontrado automaticamente quando a cópia terminar."}},"pt-PT":{"stringUnit":{"state":"translated","value":"À procura do OMSI 2: é encontrado automaticamente quando a cópia terminar."}},"ru":{"stringUnit":{"state":"translated","value":"Ищем OMSI 2: игра найдётся сама, как только копирование завершится."}},"sv":{"stringUnit":{"state":"translated","value":"Letar efter OMSI 2: det hittas automatiskt när kopieringen är klar."}},"th":{"stringUnit":{"state":"translated","value":"กำลังค้นหา OMSI 2 จะพบเองเมื่อคัดลอกเสร็จ"}},"fil":{"stringUnit":{"state":"translated","value":"Hinahanap ang OMSI 2: kusa itong makikita kapag tapos na ang pagkopya."}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2 aranıyor: kopyalama bitince kendiliğinden bulunur."}},"uk":{"stringUnit":{"state":"translated","value":"Шукаємо OMSI 2: гра знайдеться сама, щойно копіювання завершиться."}},"vi":{"stringUnit":{"state":"translated","value":"Đang tìm OMSI 2: sẽ tự động tìm thấy khi sao chép xong."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在查找OMSI 2：复制完成后会自动找到。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在尋找 OMSI 2：複製完成後便會自動找到。"}}}},
