    "Copy OMSI 2 onto this device": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Скапіруйце OMSI 2 на гэтую прыладу"}},"ca":{"stringUnit":{"state":"translated","value":"Copia OMSI 2 en aquest dispositiu"}},"cs":{"stringUnit":{"state":"translated","value":"Zkopírujte OMSI 2 do tohoto zařízení"}},"de":{"stringUnit":{"state":"translated","value":"Kopiere OMSI 2 auf dieses Gerät"}},"es":{"stringUnit":{"state":"translated","value":"Copia OMSI 2 en este dispositivo"}},"fr":{"stringUnit":{"state":"translated","value":"Copiez OMSI 2 sur cet appareil"}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 को इस डिवाइस पर कॉपी करें"}},"hu":{"stringUnit":{"state":"translated","value":"Másold az OMSI 2-t erre az eszközre"}},"id":{"stringUnit":{"state":"translated","value":"Salin OMSI 2 ke perangkat ini"}},"it":{"stringUnit":{"state":"translated","value":"Copia OMSI 2 su questo dispositivo"}},"ja":{"stringUnit":{"state":"translated","value":"OMSI 2をこのデバイスにコピー"}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2-ні осы құрылғыға көшіріңіз"}},"ko":{"stringUnit":{"state":"translated","value":"OMSI 2를 이 기기에 복사"}},"ms":{"stringUnit":{"state":"translated","value":"Salin OMSI 2 ke peranti ini"}},"nl":{"stringUnit":{"state":"translated","value":"Kopieer OMSI 2 naar dit apparaat"}},"pl":{"stringUnit":{"state":"translated","value":"Skopiuj OMSI 2 na to urządzenie"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copie o OMSI 2 para este dispositivo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Copie o OMSI 2 para este dispositivo"}},"ru":{"stringUnit":{"state":"translated","value":"Скопируйте OMSI 2 на это устройство"}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera OMSI 2 till den här enheten"}},"th":{"stringUnit":{"state":"translated","value":"คัดลอก OMSI 2 ลงในอุปกรณ์นี้"}},"fil":{"stringUnit":{"state":"translated","value":"Kopyahin ang OMSI 2 sa device na ito"}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2'yi bu cihaza kopyalayın"}},"uk":{"stringUnit":{"state":"translated","value":"Скопіюйте OMSI 2 на цей пристрій"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép OMSI 2 vào thiết bị này"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将OMSI 2复制到此设备"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將 OMSI 2 複製到此裝置"}}}},
    "Copy the OMSI 2 folder onto a USB drive and plug it into the iPhone or iPad.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Скапіруйце тэчку OMSI 2 на USB-назапашвальнік і падключыце яго да iPhone або iPad."}},"ca":{"stringUnit":{"state":"translated","value":"Copia la carpeta OMSI 2 en una memòria USB i connecta-la a l'iPhone o l'iPad."}},"cs":{"stringUnit":{"state":"translated","value":"Zkopírujte složku OMSI 2 na USB disk a připojte ho k iPhonu nebo iPadu."}},"de":{"stringUnit":{"state":"translated","value":"Kopiere den OMSI-2-Ordner auf einen USB-Stick und stecke ihn ins iPhone oder iPad."}},"es":{"stringUnit":{"state":"translated","value":"Copia la carpeta OMSI 2 en una memoria USB y conéctala al iPhone o iPad."}},"fr":{"stringUnit":{"state":"translated","value":"Copiez le dossier OMSI 2 sur une clé USB et branchez-la sur l'iPhone ou l'iPad."}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 फ़ोल्डर को USB ड्राइव पर कॉपी करें और उसे iPhone या iPad में लगाएँ।"}},"hu":{"stringUnit":{"state":"translated","value":"Másold az OMSI 2 mappát egy USB-meghajtóra, és csatlakoztasd az iPhone-hoz vagy az iPadhez."}},"id":{"stringUnit":{"state":"translated","value":"Salin folder OMSI 2 ke drive USB, lalu colokkan ke iPhone atau iPad."}},"it":{"stringUnit":{"state":"translated","value":"Copia la cartella OMSI 2 su una chiavetta USB e collegala all'iPhone o all'iPad."}},"ja":{"stringUnit":{"state":"translated","value":"OMSI 2フォルダをUSBドライブにコピーし、iPhoneまたはiPadに接続します。"}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2 қалтасын USB жинақтағышқа көшіріп, оны iPhone не iPad-қа қосыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"OMSI 2 폴더를 USB 드라이브에 복사한 다음 iPhone 또는 iPad에 연결하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Salin folder OMSI 2 ke pemacu USB dan sambungkannya ke iPhone atau iPad."}},"nl":{"stringUnit":{"state":"translated","value":"Kopieer de OMSI 2-map naar een USB-stick en sluit die aan op de iPhone of iPad."}},"pl":{"stringUnit":{"state":"translated","value":"Skopiuj folder OMSI 2 na dysk USB i podłącz go do iPhone’a lub iPada."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copie a pasta OMSI 2 para um pendrive e conecte-o ao iPhone ou iPad."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Copie a pasta OMSI 2 para uma pen USB e ligue-a ao iPhone ou iPad."}},"ru":{"stringUnit":{"state":"translated","value":"Скопируйте папку OMSI 2 на USB-накопитель и подключите его к iPhone или iPad."}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera OMSI 2-mappen till ett USB-minne och anslut det till iPhone eller iPad."}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกโฟลเดอร์ OMSI 2 ลงในไดรฟ์ USB แล้วเสียบเข้ากับ iPhone หรือ iPad"}},"fil":{"stringUnit":{"state":"translated","value":"Kopyahin ang OMSI 2 folder sa isang USB drive at isaksak ito sa iPhone o iPad."}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2 klasörünü bir USB belleğe kopyalayın ve iPhone'a veya iPad'e takın."}},"uk":{"stringUnit":{"state":"translated","value":"Скопіюйте теку OMSI 2 на USB-накопичувач і під'єднайте його до iPhone або iPad."}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép thư mục OMSI 2 vào ổ USB rồi cắm vào iPhone hoặc iPad."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将OMSI 2文件夹复制到U盘，然后将U盘插入iPhone或iPad。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將 OMSI 2 資料夾複製到 USB 隨身碟，再將它插入 iPhone 或 iPad。"}}}},
    "Count me in the website's \"playing now\" (anonymous)": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Compta'm a «jugant ara» del web (anònim)"}},"de":{"stringUnit":{"state":"translated","value":"Mich zu \"Spielen aktuell\" auf der Website dazuzählen (anonym)"}},"fr":{"stringUnit":{"state":"translated","value":"Me compter dans les « en jeu maintenant » du site (anonyme)"}},"nl":{"stringUnit":{"state":"translated","value":"Mij anoniem meetellen bij 'nu aan het spelen' op de website"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Incluir-me no \"jogando agora\" do site (anônimo)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Incluir-me no \"a jogar agora\" do site (anónimo)"}},"sv":{"stringUnit":{"state":"translated","value":"Räkna med mig i webbplatsens ”spelar nu” (anonymt)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将我计入网站的“正在游玩”人数（匿名）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將我計入網站的「目前遊玩人數」（匿名）"}}}},
