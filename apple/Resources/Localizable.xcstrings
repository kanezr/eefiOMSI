    "Connect the iPhone or iPad to the Mac with a cable.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Падключыце iPhone або iPad да Mac кабелем."}},"ca":{"stringUnit":{"state":"translated","value":"Connecta l'iPhone o l'iPad al Mac amb un cable."}},"cs":{"stringUnit":{"state":"translated","value":"Připojte iPhone nebo iPad k Macu kabelem."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde das iPhone oder iPad per Kabel mit dem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Conecta el iPhone o iPad al Mac con un cable."}},"fr":{"stringUnit":{"state":"translated","value":"Branchez l'iPhone ou l'iPad au Mac avec un câble."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone या iPad को केबल से Mac से जोड़ें।"}},"hu":{"stringUnit":{"state":"translated","value":"Csatlakoztasd az iPhone-t vagy az iPadet kábellel a Machez."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan iPhone atau iPad ke Mac dengan kabel."}},"it":{"stringUnit":{"state":"translated","value":"Collega l'iPhone o l'iPad al Mac con un cavo."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneまたはiPadをケーブルでMacに接続します。"}},"kk":{"stringUnit":{"state":"translated","value":"iPhone не iPad-ты Mac-қа кабельмен қосыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 또는 iPad를 케이블로 Mac에 연결하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Sambungkan iPhone atau iPad ke Mac dengan kabel."}},"nl":{"stringUnit":{"state":"translated","value":"Sluit de iPhone of iPad met een kabel aan op de Mac."}},"pl":{"stringUnit":{"state":"translated","value":"Podłącz iPhone’a lub iPada do Maca kablem."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte o iPhone ou iPad ao Mac com um cabo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ligue o iPhone ou iPad ao Mac com um cabo."}},"ru":{"stringUnit":{"state":"translated","value":"Подключите iPhone или iPad к Mac кабелем."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut iPhone eller iPad till Macen med en kabel."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อ iPhone หรือ iPad กับ Mac ด้วยสายเคเบิล"}},"fil":{"stringUnit":{"state":"translated","value":"Ikonekta ang iPhone o iPad sa Mac gamit ang cable."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'u veya iPad'i Mac'e kabloyla bağlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Під'єднайте iPhone або iPad до Mac кабелем."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối iPhone hoặc iPad với máy Mac bằng cáp."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用数据线将iPhone或iPad连接到Mac。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以傳輸線將 iPhone 或 iPad 連接到 Mac。"}}}},
    "Connect the iPhone or iPad with a cable, then open Files (File Sharing in iTunes).": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Падключыце iPhone або iPad кабелем, потым адкрыйце «Файлы» («Агульны доступ да файлаў» у iTunes)."}},"ca":{"stringUnit":{"state":"translated","value":"Connecta l'iPhone o l'iPad amb un cable i obre Fitxers (Compartició de fitxers a l'iTunes)."}},"cs":{"stringUnit":{"state":"translated","value":"Připojte iPhone nebo iPad kabelem, pak otevřete „Soubory“ („Sdílení souborů“ v iTunes)."}},"de":{"stringUnit":{"state":"translated","value":"Verbinde das iPhone oder iPad per Kabel und öffne dann Dateien (Dateifreigabe in iTunes)."}},"es":{"stringUnit":{"state":"translated","value":"Conecta el iPhone o iPad con un cable y abre Archivos (Compartir archivos en iTunes)."}},"fr":{"stringUnit":{"state":"translated","value":"Branchez l'iPhone ou l'iPad avec un câble, puis ouvrez Fichiers (Partage de fichiers dans iTunes)."}},"hi":{"stringUnit":{"state":"translated","value":"iPhone या iPad को केबल से जोड़ें, फिर फ़ाइलें खोलें (iTunes में फ़ाइल शेयरिंग)।"}},"hu":{"stringUnit":{"state":"translated","value":"Csatlakoztasd az iPhone-t vagy az iPadet kábellel, majd nyisd meg a „Fájlok” lapot (iTunesban „Fájlmegosztás”)."}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan iPhone atau iPad dengan kabel, lalu buka File (Berbagi File di iTunes)."}},"it":{"stringUnit":{"state":"translated","value":"Collega l'iPhone o l'iPad con un cavo, poi apri File (Condivisione file in iTunes)."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneまたはiPadをケーブルで接続し、「ファイル」を開きます（iTunesでは「ファイル共有」）。"}},"kk":{"stringUnit":{"state":"translated","value":"iPhone не iPad-ты кабельмен қосыңыз, содан кейін «Файлдар» бөлімін ашыңыз (iTunes-те «Файлдарды бөлісу»)."}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 또는 iPad를 케이블로 연결한 다음 파일을 여세요(iTunes에서는 파일 공유)."}},"ms":{"stringUnit":{"state":"translated","value":"Sambungkan iPhone atau iPad dengan kabel, kemudian buka Fail (Perkongsian Fail dalam iTunes)."}},"nl":{"stringUnit":{"state":"translated","value":"Sluit de iPhone of iPad aan met een kabel en open Bestanden (Bestandsdeling in iTunes)."}},"pl":{"stringUnit":{"state":"translated","value":"Podłącz iPhone’a lub iPada kablem, potem otwórz „Pliki” („Udostępnianie plików” w iTunes)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conecte o iPhone ou iPad com um cabo e abra Arquivos (Compartilhamento de Arquivos no iTunes)."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ligue o iPhone ou iPad com um cabo e abra Ficheiros (Partilha de ficheiros no iTunes)."}},"ru":{"stringUnit":{"state":"translated","value":"Подключите iPhone или iPad кабелем, затем откройте «Файлы» («Общие файлы» в iTunes)."}},"sv":{"stringUnit":{"state":"translated","value":"Anslut iPhone eller iPad med en kabel och öppna Filer (Fildelning i iTunes)."}},"th":{"stringUnit":{"state":"translated","value":"เชื่อมต่อ iPhone หรือ iPad ด้วยสายเคเบิล แล้วเปิด “ไฟล์” (“การแชร์ไฟล์” ใน iTunes)"}},"fil":{"stringUnit":{"state":"translated","value":"Ikonekta ang iPhone o iPad gamit ang cable, saka buksan ang Files (File Sharing sa iTunes)."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone'u veya iPad'i kabloyla bağlayın, ardından “Dosyalar”ı açın (iTunes'ta “Dosya Paylaşma”)."}},"uk":{"stringUnit":{"state":"translated","value":"Під'єднайте iPhone або iPad кабелем, потім відкрийте «Файли» («Спільний доступ до файлів» в iTunes)."}},"vi":{"stringUnit":{"state":"translated","value":"Kết nối iPhone hoặc iPad bằng cáp, rồi mở Tệp (Chia sẻ tệp trong iTunes)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用数据线连接iPhone或iPad，然后打开“文件”（在iTunes中为“文件共享”）。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以傳輸線連接 iPhone 或 iPad，然後開啟「檔案」（iTunes 中為「檔案共享」）。"}}}},
