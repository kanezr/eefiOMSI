    "Other buses of the timetable drive their lines": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Andere Busse des Fahrplans fahren ihre Linien"}},"ru":{"stringUnit":{"state":"translated","value":"Другие автобусы расписания ездят по своим линиям"}},"sv":{"stringUnit":{"state":"translated","value":"Andra tidtabellsbussar kör sina linjer"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其他時刻表巴士會依路線行駛"}}}},
