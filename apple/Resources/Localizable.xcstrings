    "Create a driver to start a personnel file.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Стварыце вадзіцеля, каб завесці асабістую справу."}},"ca":{"stringUnit":{"state":"translated","value":"Crea un conductor per iniciar un expedient."}},"cs":{"stringUnit":{"state":"translated","value":"Vytvořte řidiče a založte osobní spis."}},"de":{"stringUnit":{"state":"translated","value":"Lege einen Fahrer an, um eine Personalakte zu beginnen."}},"es":{"stringUnit":{"state":"translated","value":"Crea un conductor para iniciar un expediente."}},"fr":{"stringUnit":{"state":"translated","value":"Créez un conducteur pour ouvrir un dossier."}},"hi":{"stringUnit":{"state":"translated","value":"पर्सनल फ़ाइल शुरू करने के लिए एक ड्राइवर बनाएँ।"}},"hu":{"stringUnit":{"state":"translated","value":"Hozz létre egy sofőrt a személyi lap létrehozásához."}},"id":{"stringUnit":{"state":"translated","value":"Buat pengemudi untuk memulai catatan personel."}},"it":{"stringUnit":{"state":"translated","value":"Crea un conducente per iniziare un fascicolo personale."}},"ja":{"stringUnit":{"state":"translated","value":"人事ファイルを始めるには運転手を作成してください。"}},"kk":{"stringUnit":{"state":"translated","value":"Жеке іс парағын бастау үшін жүргізуші жасаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"운전자 기록을 시작하려면 운전자를 만드세요."}},"ms":{"stringUnit":{"state":"translated","value":"Cipta pemandu untuk memulakan rekod peribadi."}},"nl":{"stringUnit":{"state":"translated","value":"Maak een bestuurder aan om een personeelsdossier te starten."}},"pl":{"stringUnit":{"state":"translated","value":"Utwórz kierowcę, aby założyć akta osobowe."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Crie um motorista para iniciar um registro."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Crie um condutor para iniciar um registro."}},"ru":{"stringUnit":{"state":"translated","value":"Создайте водителя, чтобы завести личное дело."}},"sv":{"stringUnit":{"state":"translated","value":"Skapa en förare för att påbörja en personalakt."}},"th":{"stringUnit":{"state":"translated","value":"สร้างคนขับเพื่อเริ่มบันทึกข้อมูลบุคลากร"}},"fil":{"stringUnit":{"state":"translated","value":"Gumawa ng driver para magsimula ng personnel record."}},"tr":{"stringUnit":{"state":"translated","value":"Özlük dosyası başlatmak için bir sürücü oluşturun."}},"uk":{"stringUnit":{"state":"translated","value":"Створіть водія, щоб завести особове діло."}},"vi":{"stringUnit":{"state":"translated","value":"Tạo tài xế để bắt đầu hồ sơ cá nhân."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建司机以开启人事档案。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建立司機以開始記錄個人資料。"}}}},
