te":"translated","value":"I-drag ang OMSI 2 folder papunta sa openOMSI."}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2 klasörünü openOMSI'nin üzerine sürükleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Перетягніть теку OMSI 2 на openOMSI."}},"vi":{"stringUnit":{"state":"translated","value":"Kéo thư mục OMSI 2 vào openOMSI."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将OMSI 2文件夹拖到openOMSI上。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將 OMSI 2 資料夾拖移到 openOMSI 上。"}}}},
    "Drive": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Ехаць"}},"ca":{"stringUnit":{"state":"translated","value":"Condueix"}},"cs":{"stringUnit":{"state":"translated","value":"Jet"}},"de":{"stringUnit":{"state":"translated","value":"Fahren"}},"es":{"stringUnit":{"state":"translated","value":"Conducir"}},"fr":{"stringUnit":{"state":"translated","value":"Conduire"}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव"}},"hu":{"stringUnit":{"state":"translated","value":"Vezetés"}},"id":{"stringUnit":{"state":"translated","value":"Mengemudi"}},"it":{"stringUnit":{"state":"translated","value":"Guida"}},"ja":{"stringUnit":{"state":"translated","value":"運転"}},"kk":{"stringUnit":{"state":"translated","value":"Жүру"}},"ko":{"stringUnit":{"state":"translated","value":"운전"}},"ms":{"stringUnit":{"state":"translated","value":"Pandu"}},"nl":{"stringUnit":{"state":"translated","value":"Rijden"}},"pl":{"stringUnit":{"state":"translated","value":"Jedź"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirigir"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Conduzir"}},"ru":{"stringUnit":{"state":"translated","value":"Поездка"}},"sv":{"stringUnit":{"state":"translated","value":"Kör"}},"th":{"stringUnit":{"state":"translated","value":"ขับรถ"}},"fil":{"stringUnit":{"state":"translated","value":"Magmaneho"}},"tr":{"stringUnit":{"state":"translated","value":"Sürüş"}},"uk":{"stringUnit":{"state":"translated","value":"Їхати"}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"驾驶"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"駕駛"}}}},
    "Drive the buses of OMSI 2 wherever you are: its maps, its buses and its lines, at your fingertips.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіце аўтобусы OMSI 2 дзе заўгодна: яе карты, аўтобусы і маршруты — у вас пад рукой."}},"ca":{"stringUnit":{"state":"translated","value":"Condueix els autobusos d'OMSI 2 siguis on siguis: els seus mapes, els seus autobusos i les seves línies, a l'abast dels dits."}},"cs":{"stringUnit":{"state":"translated","value":"Řiďte autobusy z OMSI 2, ať jste kdekoli: jeho mapy, autobusy a linky máte po ruce."}},"de":{"stringUnit":{"state":"translated","value":"Fahre die Busse von OMSI 2, wo immer du bist: seine Karten, seine Busse und seine Linien, direkt unter deinen Fingern."}},"es":{"stringUnit":{"state":"translated","value":"Conduce los autobuses de OMSI 2 estés donde estés: sus mapas, sus autobuses y sus líneas, al alcance de tus dedos."}},"fr":{"stringUnit":{"state":"translated","value":"Conduisez les bus d'OMSI 2 où que vous soyez : ses cartes, ses bus et ses lignes, au bout des doigts."}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 की बसें कहीं भी चलाएँ: इसके मैप, बसें और लाइनें, आपकी उँगलियों पर।"}},"hu":{"stringUnit":{"state":"translated","value":"Vezesd az OMSI 2 buszait, bárhol is vagy: a térképei, a buszai és a vonalai mind kéznél vannak."}},"id":{"stringUnit":{"state":"translated","value":"Kemudikan bus OMSI 2 di mana saja: peta, bus, dan rutenya, di ujung jari Anda."}},"it":{"stringUnit":{"state":"translated","value":"Guida i bus di OMSI 2 ovunque tu sia: le sue mappe, i suoi bus e le sue linee, a portata di dito."}},"ja":{"stringUnit":{"state":"translated","value":"どこにいてもOMSI 2のバスを運転しよう。マップもバスも路線も、指先ひとつで。"}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2 автобустарын қай жерде болсаңыз да жүргізіңіз: оның карталары, автобустары мен желілері — қол астыңызда."}},"ko":{"stringUnit":{"state":"translated","value":"어디서나 OMSI 2의 버스를 운전하세요. 맵, 버스, 노선을 손끝으로 만나 보세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pandu bas OMSI 2 di mana sahaja: peta, bas dan laluannya, di hujung jari anda."}},"nl":{"stringUnit":{"state":"translated","value":"Rijd met de bussen van OMSI 2, waar je ook bent: de kaarten, de bussen en de lijnen, binnen handbereik."}},"pl":{"stringUnit":{"state":"translated","value":"Prowadź autobusy z OMSI 2, gdziekolwiek jesteś: jego mapy, autobusy i linie masz pod ręką."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirija os ônibus do OMSI 2 onde você estiver: seus mapas, seus ônibus e suas linhas, na ponta dos dedos."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Conduza os autocarros do OMSI 2 onde quer que esteja: os seus mapas, os seus autocarros e as suas linhas, na ponta dos dedos."}},"ru":{"stringUnit":{"state":"translated","value":"Водите автобусы OMSI 2 где угодно: её карты, автобусы и маршруты — у вас под рукой."}},"sv":{"stringUnit":{"state":"translated","value":"Kör bussarna i OMSI 2 var du än är: kartorna, bussarna och linjerna, alltid nära till hands."}},"th":{"stringUnit":{"state":"translated","value":"ขับรถบัสของ OMSI 2 ได้ทุกที่ ทั้งแผนที่ รถบัส และสายรถ อยู่แค่ปลายนิ้ว"}},"fil":{"stringUnit":{"state":"translated","value":"Imaneho ang mga bus ng OMSI 2 kahit nasaan ka: ang mga mapa, bus at linya nito, abot-kamay mo."}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2'nin otobüslerini nerede olursanız olun kullanın: haritaları, otobüsleri ve hatları parmaklarınızın ucunda."}},"uk":{"stringUnit":{"state":"translated","value":"Керуйте автобусами OMSI 2 будь-де: її карти, автобуси й маршрути — у вас під рукою."}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe buýt của OMSI 2 ở bất cứ đâu: bản đồ, xe buýt và tuyến đường, ngay trong tầm tay."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"随时随地驾驶OMSI 2的巴士：地图、车辆和线路，尽在指尖。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"隨時隨地駕駛 OMSI 2 的巴士：地圖、車輛與路線，盡在指尖。"}}}},
    "Drive with friends by a code, or on servers that are always on.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гуляйце з сябрамі па кодзе або на серверах, што працуюць пастаянна."}},"ca":{"stringUnit":{"state":"translated","value":"Condueix amb amics mitjançant un codi o en servidors que estan sempre actius."}},"cs":{"stringUnit":{"state":"translated","value":"Jezděte s kamarády pomocí kódu nebo na serverech, které běží pořád."}},"de":{"stringUnit":{"state":"translated","value":"Fahre mit Freunden per Code oder auf Servern, die immer laufen."}},"es":{"stringUnit":{"state":"translated","value":"Conduce con amigos con un código, o en servidores siempre activos."}},"fr":{"stringUnit":{"state":"translated","value":"Roulez avec des amis par code ou sur des serveurs toujours en ligne."}},"hi":{"stringUnit":{"state":"translated","value":"दोस्तों के साथ कोड से चलाएँ, या हमेशा चालू रहने वाले सर्वरों पर।"}},"hu":{"stringUnit":{"state":"translated","value":"Vezess barátokkal kóddal, vagy folyamatosan futó szervereken."}},"id":{"stringUnit":{"state":"translated","value":"Mengemudi dengan teman lewat kode atau di server yang selalu aktif."}},"it":{"stringUnit":{"state":"translated","value":"Guida con gli amici tramite un codice, o su server sempre attivi."}},"ja":{"stringUnit":{"state":"translated","value":"コードで友達と、または常時稼働のサーバーで一緒に運転します。"}},"kk":{"stringUnit":{"state":"translated","value":"Достармен кодпен немесе үнемі қосулы серверлерде жүріңіз."}},"ko":{"stringUnit":{"state":"translated","value":"코드를 통해 친구와 운전하거나 상시 운영 서버에 참가하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pandu dengan rakan menggunakan kod atau di pelayan yang sentiasa aktif."}},"nl":{"stringUnit":{"state":"translated","value":"Rijd met vrienden via een code, of op servers die altijd aan staan."}},"pl":{"stringUnit":{"state":"translated","value":"Jedź ze znajomymi po kodzie lub na serwerach działających cały czas."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirija com amigos usando um código, ou em servidores sempre ligados."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Dirija com amigos usando um código, ou em servidores sempre ligados."}},"ru":{"stringUnit":{"state":"translated","value":"Ездите с друзьями по коду или на серверах, которые работают всегда."}},"sv":{"stringUnit":{"state":"translated","value":"Kör med vänner med hjälp av en kod eller på servrar som alltid är igång."}},"th":{"stringUnit":{"state":"translated","value":"ขับรถกับเพื่อนผ่านรหัสหรือบนเซิร์ฟเวอร์ที่เปิดตลอดเวลา"}},"fil":{"stringUnit":{"state":"translated","value":"Magmaneho kasama ang mga kaibigan gamit ang code o sa laging online na server."}},"tr":{"stringUnit":{"state":"translated","value":"Arkadaşlarla kodla veya her zaman açık sunucularda sürün."}},"uk":{"stringUnit":{"state":"translated","value":"Грайте з друзями за кодом або на серверах, що працюють постійно."}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe cùng bạn bè bằng mã hoặc trên máy chủ hoạt động liên tục."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过会话码,或在常开的服务器上与朋友一起驾驶。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用連線碼與朋友一同駕駛，或加入長期在線的伺服器。"}}}},
    "Driver": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіцель"}},"ca":{"stringUnit":{"state":"translated","value":"Conductor"}},"cs":{"stringUnit":{"state":"translated","value":"Řidič"}},"de":{"stringUnit":{"state":"translated","value":"Fahrer"}},"es":{"stringUnit":{"state":"translated","value":"Conductor"}},"fr":{"stringUnit":{"state":"translated","value":"Conducteur"}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइवर"}},"hu":{"stringUnit":{"state":"translated","value":"Sofőr"}},"id":{"stringUnit":{"state":"translated","value":"Pengemudi"}},"it":{"stringUnit":{"state":"translated","value":"Conducente"}},"ja":{"stringUnit":{"state":"translated","value":"運転手"}},"kk":{"stringUnit":{"state":"translated","value":"Жүргізуші"}},"ko":{"stringUnit":{"state":"translated","value":"운전자"}},"ms":{"stringUnit":{"state":"translated","value":"Pemandu"}},"nl":{"stringUnit":{"state":"translated","value":"Bestuurder"}},"pl":{"stringUnit":{"state":"translated","value":"Kierowca"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Motorista"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Condutor"}},"ru":{"stringUnit":{"state":"translated","value":"Водитель"}},"sv":{"stringUnit":{"state":"translated","value":"Förare"}},"th":{"stringUnit":{"state":"translated","value":"คนขับ"}},"fil":{"stringUnit":{"state":"translated","value":"Driver"}},"tr":{"stringUnit":{"state":"translated","value":"Sürücü"}},"uk":{"stringUnit":{"state":"translated","value":"Водій"}},"vi":{"stringUnit":{"state":"translated","value":"Tài xế"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"司机"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"司機"}}}},
    "Driver at the wheel (outside views)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіцель за рулём (від звонку)"}},"ca":{"stringUnit":{"state":"translated","value":"Conductor al volant (vistes exteriors)"}},"cs":{"stringUnit":{"state":"translated","value":"Řidič za volantem (vnější pohledy)"}},"de":{"stringUnit":{"state":"translated","value":"Fahrer am Steuer (Außenansichten)"}},"es":{"stringUnit":{"state":"translated","value":"Conductor al volante (vistas exteriores)"}},"fr":{"stringUnit":{"state":"translated","value":"Conducteur au volant (vues extérieures)"}},"hi":{"stringUnit":{"state":"translated","value":"स्टीयरिंग पर ड्राइवर (बाहरी व्यू)"}},"hu":{"stringUnit":{"state":"translated","value":"Sofőr a kormánynál (külső nézetben)"}},"id":{"stringUnit":{"state":"translated","value":"Tampilkan sopir pada tampilan luar"}},"it":{"stringUnit":{"state":"translated","value":"Conducente al volante (viste esterne)"}},"ja":{"stringUnit":{"state":"translated","value":"運転席のドライバー(車外視点)"}},"kk":{"stringUnit":{"state":"translated","value":"Рульдегі жүргізуші (сыртқы көріністер)"}},"ko":{"stringUnit":{"state":"translated","value":"외부 시점에서 운전자 표시"}},"ms":{"stringUnit":{"state":"translated","value":"Papar pemandu dalam pandangan luar"}},"nl":{"stringUnit":{"state":"translated","value":"Bestuurder achter het stuur (buitenaanzichten)"}},"pl":{"stringUnit":{"state":"translated","value":"Kierowca za kierownicą (widoki zewnętrzne)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Motorista ao volante (vistas externas)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Condutor ao volante (vistas externas)"}},"ru":{"stringUnit":{"state":"translated","value":"Водитель за рулём (виды снаружи)"}},"sv":{"stringUnit":{"state":"translated","value":"Förare vid ratten (yttre vyer)"}},"th":{"stringUnit":{"state":"translated","value":"แสดงคนขับเมื่อมองจากภายนอก"}},"fil":{"stringUnit":{"state":"translated","value":"Ipakita ang driver sa outside view"}},"tr":{"stringUnit":{"state":"translated","value":"Direksiyondaki sürücü (dış görünümler)"}},"uk":{"stringUnit":{"state":"translated","value":"Водій за кермом (вигляд ззовні)"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện tài xế ở góc nhìn bên ngoài"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"方向盘前的司机(车外视角)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"車外視角顯示司機"}}}},
    "Driver's hands in the cab view": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Mans del conductor a la vista de cabina"}},"de":{"stringUnit":{"state":"translated","value":"Hände des Fahrers in der Fahrersicht"}},"es":{"stringUnit":{"state":"translated","value":"Manos del conductor en la vista de cabina"}},"fr":{"stringUnit":{"state":"translated","value":"Mains du conducteur dans la vue Conduite"}},"nl":{"stringUnit":{"state":"translated","value":"Handen van de bestuurder in de cabineweergave"}},"pl":{"stringUnit":{"state":"translated","value":"Dłonie kierowcy w widoku z kabiny"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mãos do motorista na vista da cabine"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Mãos do condutor na vista da cabine"}},"ru":{"stringUnit":{"state":"translated","value":"Руки водителя в виде из кабины"}},"sv":{"stringUnit":{"state":"translated","value":"Förarens händer i förarhyttsvyn"}},"uk":{"stringUnit":{"state":"translated","value":"Руки водія у вигляді з кабіни"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"驾驶室视角中显示司机的手"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"駕駛室視角中的駕駛員雙手"}}}},
