    "Old Steering (the wheel stays, turn it back yourself)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Стары рэжым руля (руль застаецца, вярніце яго самі)"}},"ca":{"stringUnit":{"state":"translated","value":"Direcció antiga (el volant es queda on és; l'has de tornar tu)"}},"cs":{"stringUnit":{"state":"translated","value":"Staré řízení (volant zůstane, otočte ho zpět sami)"}},"de":{"stringUnit":{"state":"translated","value":"Alte Lenkung (das Lenkrad bleibt stehen, selbst zurückdrehen)"}},"es":{"stringUnit":{"state":"translated","value":"Volante antiguo (el volante se queda, gíralo tú de vuelta)"}},"fr":{"stringUnit":{"state":"translated","value":"Ancienne direction (le volant reste en place, à remettre soi-même)"}},"hi":{"stringUnit":{"state":"translated","value":"पुरानी स्टीयरिंग (पहिया जहाँ है वहीं रहता है, खुद वापस घुमाएँ)"}},"hu":{"stringUnit":{"state":"translated","value":"Legacy kormányzás (a kormány marad az utolsó pozíciójában)"}},"it":{"stringUnit":{"state":"translated","value":"Vecchio sterzo (il volante resta, riportalo tu)"}},"ja":{"stringUnit":{"state":"translated","value":"旧式ステアリング(ハンドルはそのままなので、自分で戻してください)"}},"kk":{"stringUnit":{"state":"translated","value":"Ескі рульдеу (руль орнында қалады, өзіңіз қайта бұрыңыз)"}},"nl":{"stringUnit":{"state":"translated","value":"Oude besturing (het stuur blijft staan, draai het zelf terug)"}},"pl":{"stringUnit":{"state":"translated","value":"Stare sterowanie (kierownica zostaje, odkręć ją sam)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Direção antiga (o volante fica onde está, gire-o de volta você mesmo)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Direção antiga (o volante fica onde está, gire-o de volta você mesmo)"}},"ru":{"stringUnit":{"state":"translated","value":"Старое рулевое управление (руль остаётся на месте, возвращайте сами)"}},"sv":{"stringUnit":{"state":"translated","value":"Gammal styrning (ratten stannar, vrid tillbaka den själv)"}},"tr":{"stringUnit":{"state":"translated","value":"Eski direksiyon (direksiyon olduğu yerde kalır, kendiniz geri çevirin)"}},"uk":{"stringUnit":{"state":"translated","value":"Стара схема керування (кермо залишається, поверніть його самі)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"旧版转向(方向盘保持原位,请自行回正)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"傳統轉向（方向盤保持原位，需手動回正）"}}}},
    "On Steam: right-click OMSI 2, then Manage, then Browse local files.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"У Steam: пстрыкніце правай кнопкай па OMSI 2, потым «Кіраванне», потым «Праглядзець лакальныя файлы»."}},"ca":{"stringUnit":{"state":"translated","value":"A Steam: clic dret a OMSI 2, després Gestiona i després Explora els fitxers locals."}},"cs":{"stringUnit":{"state":"translated","value":"Ve Steamu: klikněte pravým tlačítkem na OMSI 2, pak na „Spravovat“, pak na „Procházet místní soubory“."}},"de":{"stringUnit":{"state":"translated","value":"In Steam: Rechtsklick auf OMSI 2, dann Verwalten, dann Lokale Dateien durchsuchen."}},"es":{"stringUnit":{"state":"translated","value":"En Steam: clic derecho en OMSI 2, luego Administrar y luego Ver archivos locales."}},"fr":{"stringUnit":{"state":"translated","value":"Sur Steam : clic droit sur OMSI 2, puis Gérer, puis Parcourir les fichiers locaux."}},"hi":{"stringUnit":{"state":"translated","value":"Steam पर: OMSI 2 पर राइट-क्लिक करें, फिर Manage, फिर Browse local files।"}},"hu":{"stringUnit":{"state":"translated","value":"Steamen: kattints jobb gombbal az OMSI 2-re, majd „Kezelés”, majd „Helyi fájlok tallózása”."}},"id":{"stringUnit":{"state":"translated","value":"Di Steam: klik kanan OMSI 2, lalu Kelola, lalu Telusuri berkas lokal."}},"it":{"stringUnit":{"state":"translated","value":"Su Steam: clic destro su OMSI 2, poi Gestisci, poi Sfoglia i file locali."}},"ja":{"stringUnit":{"state":"translated","value":"Steamの場合：OMSI 2を右クリックし、「管理」→「ローカルファイルを閲覧」を選びます。"}},"kk":{"stringUnit":{"state":"translated","value":"Steam-де: OMSI 2-ні оң жақ батырмамен басыңыз, содан кейін «Басқару», содан кейін «Жергілікті файлдарды қарау»."}},"ko":{"stringUnit":{"state":"translated","value":"Steam: OMSI 2를 마우스 오른쪽 버튼으로 클릭한 다음 관리 > 로컬 파일 보기를 선택하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Di Steam: klik kanan OMSI 2, kemudian Manage, kemudian Browse local files."}},"nl":{"stringUnit":{"state":"translated","value":"In Steam: klik met rechts op OMSI 2, dan Beheren, dan Door lokale bestanden bladeren."}},"pl":{"stringUnit":{"state":"translated","value":"W Steam: kliknij prawym przyciskiem OMSI 2, potem „Zarządzaj”, potem „Przeglądaj pliki lokalne”."}},"pt-BR":{"stringUnit":{"state":"translated","value":"No Steam: clique com o botão direito em OMSI 2, depois em Gerenciar e em Ver arquivos locais."}},"pt-PT":{"stringUnit":{"state":"translated","value":"No Steam: clique com o botão direito em OMSI 2, depois em Gerir e em Explorar ficheiros locais."}},"ru":{"stringUnit":{"state":"translated","value":"В Steam: щёлкните правой кнопкой по OMSI 2, затем «Управление», затем «Просмотреть локальные файлы»."}},"sv":{"stringUnit":{"state":"translated","value":"I Steam: högerklicka på OMSI 2, sedan Hantera, sedan Bläddra bland lokala filer."}},"th":{"stringUnit":{"state":"translated","value":"บน Steam: คลิกขวาที่ OMSI 2 แล้วเลือก “จัดการ” > “เรียกดูไฟล์ในเครื่อง”"}},"fil":{"stringUnit":{"state":"translated","value":"Sa Steam: i-right-click ang OMSI 2, saka Manage, saka Browse local files."}},"tr":{"stringUnit":{"state":"translated","value":"Steam'de: OMSI 2'ye sağ tıklayın, ardından “Yönet”, ardından “Yerel dosyalara göz at”."}},"uk":{"stringUnit":{"state":"translated","value":"У Steam: клацніть правою кнопкою на OMSI 2, потім «Керування», потім «Переглянути локальні файли»."}},"vi":{"stringUnit":{"state":"translated","value":"Trên Steam: nhấp chuột phải vào OMSI 2, chọn Quản lý, rồi Duyệt tập tin cục bộ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在Steam中：右键点击OMSI 2，然后选择“管理”→“浏览本地文件”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在 Steam 中：右鍵按一下 OMSI 2，然後選擇「管理」→「瀏覽本機檔案」。"}}}},
    "On the road": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auf der Straße"}},"ru":{"stringUnit":{"state":"translated","value":"На дороге"}},"sv":{"stringUnit":{"state":"translated","value":"På vägen"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"道路交通"}}}},
